{
  "name": "react-native-media-proxy",
  "version": "0.1.0",
  "description": "Loopback HLS proxy with disk cache for react-native-video and expo-video: session headers, Range, prefetch, retries, cache control from JS.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "author": "kalempurt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoshi-app/MediaProxyLib.git"
  },
  "homepage": "https://github.com/hoshi-app/MediaProxyLib#readme",
  "bugs": {
    "url": "https://github.com/hoshi-app/MediaProxyLib/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "ios",
    "android",
    "!android/src/test",
    "app.plugin.js",
    "expo-module.config.json",
    "docs"
  ],
  "keywords": [
    "react-native",
    "expo",
    "hls",
    "proxy",
    "cache",
    "video"
  ],
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:hls": "node tools/check-hls-url.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
